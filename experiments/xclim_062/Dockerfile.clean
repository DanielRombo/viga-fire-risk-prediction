FROM python:3.11.16-slim
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
COPY experiments/xclim_062/baseline.lock experiments/xclim_062/xclim.lock /prova/
RUN python -m pip install --no-cache-dir -r requirements.txt -c /prova/baseline.lock \
    && python -m pip install --no-cache-dir xclim==0.62.0 -c /prova/xclim.lock \
    && python -m pip check
COPY backend/ /app/
RUN python -m services.artefactos_ml
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
